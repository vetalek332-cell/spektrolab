name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  tests:
    name: Тесты и самопроверка
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.10", "3.11", "3.12"]
    steps:
      - uses: actions/checkout@v4

      - name: Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Зависимости (только numpy)
        run: |
          python -m pip install --upgrade pip
          pip install numpy

      - name: Unit-тесты
        env:
          PYTHONPATH: src
        run: python -m unittest discover -s tests -v

      - name: Самопроверка CLI
        env:
          PYTHONPATH: src
        run: python -m spektrolab selftest

      - name: Компиляция (включая GUI без установки PySide6)
        env:
          PYTHONPATH: src
        run: python -m compileall -q src
