// ============================================================================
//  СпектроЛаб — параметрическая модель учебного USB-спектрометра
//  OpenSCAD 2021.01 и новее.  Единицы: миллиметры.
//
//  Геометрия согласована с расчётом hardware/optics.py:
//    щель x=-58 → коллиматор x=-18 (f=40) → решётка x=-9,5 → объектив f=6
//    на расстоянии 32 мм по оси 25,5° к нормали решётки.
//  Ось тракта смещена: y=-3, z=23 мм (чтобы 0-й порядок проходил ниже
//  оправы объектива к светоловушке).
//
//  Детали (part): body | lid | slit | grating | lens | camera | all
//  Печать: PETG, 0,2 мм, 3 стенки, заполнение 25 % (см. stl/README.md).
// ============================================================================

part = "body";           // какую деталь показать/экспортировать
$fn = 48;                // гладкость цилиндров

// ---------------------------------------------------------------- корпус
body_l       = 120;      // длина (X), мм
body_w       = 80;       // ширина (Y), мм
body_h       = 43;       // высота стенок без крышки, мм
lid_t        = 3;        // толщина крышки, мм  (итого 43+3 = 46 мм)
wall         = 2.0;      // толщина стенок
floor_t      = 2.0;      // толщина дна
corner_r     = 5.0;      // радиус скругления корпуса
cavity_r     = 3.0;      // радиус скругления внутренней полости
tol          = 0.2;      // технологический зазор
cavity_top   = body_h - lid_t;   // 40 мм — верх полости (низ крышки)
inner_hx     = body_l/2 - wall;  // 58
inner_hy     = body_w/2 - wall;  // 38

// ---------------------------------------------------------------- оптика
axis_y       = -3.0;     // ось тракта по Y
axis_z       = 23.0;     // ось тракта по Z
slit_x       = -58.0;    // плоскость щели
coll_x       = -18.0;    // центр коллиматора (щель + f=40)
grat_x       = -9.5;     // центр решётки
cam_dist     = 32.0;     // решётка → передняя плоскость объектива
cam_plate_dist = 38.0;   // решётка → кронштейн камеры (по оси)
cam_angle    = 25.5;     // наклон оси камеры к нормали решётки, °
slit_w       = 0.03;     // ширина щели (фольга)
slit_h       = 8.0;      // высота щели
lens_d       = 25.4;     // диаметр коллимирующей линзы
lens_seat_d  = lens_d + tol;  // посадочный диаметр 25,6
lens_th      = 5.0;      // толщина линзы по оси
stop_d       = 4.0;      // апертурная диафрагма коллиматора (f/10)
grat_size    = 25.4;     // посадочный размер решётки (сама 25×25×3)
grat_th      = 3.4;      // глубина паза под решётку (3 + зазор)
ap_w         = 14;       // рабочая апертура маски решётки
ap_h         = 12;
cam_board    = 32.0;     // плата камеры
cam_hole_pitch = 28.0;   // межцентровое расстояние отверстий платы
cam_barrel_d = 14.3;     // окно под оправу объектива

// ---------------------------------------------------------------- крепёж
m3_clear     = 3.4;      // отверстие под винт M3
m3_insert_d  = 4.2;      // отверстие под термозайку M3
m3_insert_h  = 5.2;
m2_clear     = 2.4;
m2_insert_d  = 3.6;
m2_insert_h  = 4.2;
magnet_d     = 6.3;      // магнит Ø6×2
magnet_h     = 2.1;
tripod_d     = 12.2;     // гнездо 1/4"-20, наружный Ø вставки
tripod_h     = 6.0;      // глубина гнезда

// ============================================================================
//  Вспомогательные модули
// ============================================================================

// Скруглённый параллелепипед: размер [x,y,z], радиус скругления r в XY.
// Стоит на плоскости z=0, центр по XY — в (0,0).
module rounded_box(sz, r) {
    hull()
        for (x = [r, sz[0] - r])
            for (y = [r, sz[1] - r])
                translate([x - sz[0]/2, y - sz[1]/2, 0])
                    cylinder(r = r, h = sz[2]);
}

// Прямоугольная плашка (удобная обёртка).
module slab(pos, sz) {
    translate(pos) cube(sz);
}

// Отверстие под термозакладную гайку (сверху вниз).
module insert_hole(d, h) {
    cylinder(d = d, h = h);
}

// Система координат камеры: локальный X — ось объектива, Z — вертикаль.
module cam_frame() {
    translate([grat_x, axis_y, 0])
        rotate([0, 0, cam_angle])
            children();
}

// Точки крепления кронштейна камеры в его локальной системе (X, Y).
cam_base_holes = [[22, -15], [22, 15], [44, 0]];

// ============================================================================
//  КОРПУС
// ============================================================================
module body() {
    difference() {
        union() {
            // --- оболочка: наружные стенки + дно
            difference() {
                rounded_box([body_l, body_w, body_h], corner_r);
                translate([-inner_hx, -inner_hy, floor_t])
                    rounded_box([2*inner_hx, 2*inner_hy, cavity_top + 1], cavity_r);
            }

            // --- 1. направляющие кассеты щели (x = -58…-54)
            slab([slit_x, -3 - 17 - tol - 2, 4], [4, 2, 36]);          // левая
            slab([slit_x, -3 + 17 + tol, 4], [4, 2, 36]);              // правая
            slab([slit_x, -3 - 17 - tol - 2, 4], [4, 2*17 + 2*tol + 4, 2]); // полка

            // --- 2. светозащитная диафрагма после щели (x = -52,5…-51)
            slab([-52.5, -inner_hy, floor_t], [1.5, 2*inner_hy, cavity_top - floor_t]);

            // --- 3. направляющие оправы коллиматора (x = -22,5…-14,5)
            slab([-22.5, -3 - 20.5 - 2, 4], [8, 2, 36]);               // левая
            slab([-22.5, -3 + 20.5, 4], [8, 2, 36]);                   // правая
            slab([-22.5, -3 - 20.5 - 2, 4], [8, 2*20.5 + 2 + 2, 2]);   // полка

            // --- 4. рёбра канала решётки (x = -14,1…-4,9)
            slab([-14.0, -inner_hy, floor_t], [1.5, 2*inner_hy, cavity_top - floor_t]);
            slab([-6.4,  -inner_hy, floor_t], [1.5, 2*inner_hy, cavity_top - floor_t]);

            // --- 5. приливы крепления кронштейна камеры (на полу)
            cam_frame()
                for (p = cam_base_holes)
                    translate([p[0], p[1], floor_t])
                        cylinder(d = 8, h = 6);                    // z = 2…8

            // --- 6. прилив штативного гнезда 1/4"-20 (внутри, на полу)
            translate([12, 0, floor_t]) cylinder(d = 16, h = 6);

            // --- 7. приливы магнитов крышки (под полкой боковых стенок)
            for (p = [[-49, 34], [-49, -34], [49, 34], [49, -34]])
                translate([p[0] - 5, p[1] - 4, 36]) cube([10, 8, 7]);

            // --- 8. светоловушка 0-го порядка: наклонные рёбра у правой стенки
            translate([46, -3, 22]) rotate([0, 25, 0])
                cube([1.2, 26, 20], center = true);
            translate([50.5, -3, 22]) rotate([0, -25, 0])
                cube([1.2, 26, 20], center = true);
            translate([55, -3, 22]) rotate([0, 25, 0])
                cube([1.2, 26, 20], center = true);
        }

        // --- окно щели в левой стенке
        translate([-61, -3 - 6, axis_z - 5]) cube([3, 12, 10]);

        // --- апертура светозащитной диафрагмы 6×8 мм
        translate([-53, -3 - 3, axis_z - 4]) cube([2.5, 6, 8]);

        // --- окна в рёбрах канала решётки (14×12 мм)
        translate([-15, -3 - ap_w/2, axis_z - ap_h/2]) cube([10, ap_w, ap_h]);

        // --- посадочные отверстия под термозайки M3 (кронштейн камеры)
        cam_frame()
            for (p = cam_base_holes)
                translate([p[0], p[1], 8 - m3_insert_h])
                    cylinder(d = m3_insert_d, h = m3_insert_h + 0.1);

        // --- штативное гнездо: сквозное отверстие снизу в прилив
        translate([12, 0, -1]) cylinder(d = tripod_d, h = tripod_h + 1);

        // --- отверстия магнитов в приливах (сверху, глубина 2,1 мм)
        for (p = [[-49, 34], [-49, -34], [49, 34], [49, -34]])
            translate([p[0], p[1], body_h - magnet_h])
                cylinder(d = magnet_d, h = magnet_h + 0.1);

        // --- кабельный ввод в правой стенке (под разъём камеры)
        translate([inner_hx - 0.5, 17, axis_z])
            rotate([0, 90, 0]) cylinder(d = 9, h = 5);
        // пазы под стяжку у кабельного ввода
        translate([body_l/2 - 1, 12.5, axis_z]) cube([4, 2, 6]);
        translate([body_l/2 - 1, 21.5, axis_z]) cube([4, 2, 6]);
    }
}

// ============================================================================
//  КРЫШКА
// ============================================================================
module lid() {
    difference() {
        union() {
            translate([0, 0, body_h])
                rounded_box([body_l, body_w, lid_t], corner_r);
            // рёбра жёсткости снизу (в полости, над оптикой)
            translate([-40, -inner_hy + 6, body_h - 1.5]) cube([80, 2, 1.5]);
            translate([-40, inner_hy - 8, body_h - 1.5]) cube([80, 2, 1.5]);
        }
        // гнёзда магнитов снизу (соосно приливам корпуса)
        for (p = [[-49, 34], [-49, -34], [49, 34], [49, -34]])
            translate([p[0], p[1], body_h - magnet_h])
                cylinder(d = magnet_d, h = magnet_h + 0.1);
        // декоративный паз по периметру (для ориентации крышки)
        translate([-inner_hx + 2, -inner_hy + 2, body_h - 0.6])
            cube([2*inner_hx - 4, 2*inner_hy - 4, 0.6]);
    }
}

// ============================================================================
//  КАССЕТА ЩЕЛИ
// ============================================================================
module slit() {
    difference() {
        union() {
            // корпус кассеты: 34 × 34 × 4 мм
            translate([slit_x, -3 - 17, 6]) cube([4, 34, 34]);
        }
        // проходное окно 10 × 10 мм (за фольгой)
        translate([slit_x - 1, -3 - 5, axis_z - 5]) cube([6, 10, 10]);
        // цековка под фольгу 0,02 мм на наружной стороне (14 × 14)
        translate([slit_x - 0.01, -3 - 7, axis_z - 7]) cube([0.35, 14, 14]);
        // паз-ориентир (верх): кассета ставится только фольгой к стенке
        translate([slit_x + 1, -3 - 3, 38.5]) cube([2, 6, 1.5]);
    }
}

// ============================================================================
//  РАМКА РЕШЁТКИ
// ============================================================================
// Решётка устанавливается нормально к пучку (0°):
// рабочий угол 25,5° задаётся наклоном кронштейна камеры, а не решётки.
module grating() {
    difference() {
        union() {
            // рамка 34 × 34 × 5,6 мм (зазор 0,2–0,3 мм к рёбрам канала)
            translate([grat_x - 2.8, -3 - 17, 6]) cube([5.6, 34, 34]);
            // буртик сверху для извлечения
            translate([grat_x - 2.8, -3 - 10, 39]) cube([5.6, 20, 2]);
        }
        // паз под решётку 25,4 × 25,4 × 3,4 мм
        translate([grat_x - grat_th/2, -3 - grat_size/2, axis_z - grat_size/2])
            cube([grat_th, grat_size, grat_size]);
        // рабочая апертура 14 × 12 мм
        translate([grat_x - 4, -3 - ap_w/2, axis_z - ap_h/2])
            cube([8, ap_w, ap_h]);
        // окно для контроля штрихов и извлечения
        translate([grat_x - 4, -3 - 3, 37.5]) cube([8, 6, 2.5]);
    }
}

// ============================================================================
//  ОПРАВА-ПРИЖИМ КОЛЛИМАТОРА (с диафрагмой 4,0 мм)
// ============================================================================
module lens() {
    px = -22.5;                // передняя плоскость оправы
    t  = 7.8;                  // толщина оправы по оси
    difference() {
        union() {
            // пластина оправы 40,6 × 34 мм (зазор 0,2 мм в направляющих)
            translate([px, -3 - 20.3, 6]) cube([t, 40.6, 34]);
            // пружинное кольцо-фиксатор линзы (4 лепестка) на задней плоскости
            translate([px + t, axis_y, axis_z])
                rotate([0, 90, 0])
                    difference() {
                        cylinder(d = lens_d + 2.6, h = 0.7);
                        cylinder(d = lens_d - 0.4, h = 0.7);
                        for (a = [45, 135, 225, 315])
                            rotate([0, 0, a])
                                translate([-1, 0, -1]) cube([2, lens_d, 2.4]);
                    }
        }
        // посадочное гнездо линзы (открыто сзади; линза входит с натягом на лепестки)
        translate([px + 2, axis_y, axis_z])
            rotate([0, 90, 0])
                cylinder(d = lens_seat_d, h = 5.8);
        // апертурная диафрагма 4,0 мм во фронтальной стенке
        translate([px - 0.5, axis_y, axis_z])
            rotate([0, 90, 0])
                cylinder(d = stop_d, h = 2.5);
        // разгрузочные окна (масса и коробление)
        translate([px + 2, -3 - 16, 8]) cube([3, 6, 30]);
        translate([px + 2, -3 + 10, 8]) cube([3, 6, 30]);
    }
}

// ============================================================================
//  КРОНШТЕЙН КАМЕРЫ (плоскость объектива под 25,5°)
// ============================================================================
module camera() {
    cam_frame() {
        difference() {
            union() {
                // основание на полу (z = 8…11 мм): 32 × 40 мм
                translate([18, -20, 8]) cube([32, 40, 3]);
                // наклонная пластина под плату камеры 34 × 34 мм
                translate([cam_plate_dist - 2, -17, 6])
                    cube([4, 34, 34]);
                // бобышки крепления платы (M2)
                for (dy = [-cam_hole_pitch/2, cam_hole_pitch/2])
                    for (dz = [-cam_hole_pitch/2, cam_hole_pitch/2])
                        translate([cam_plate_dist + 2, dy, axis_z + dz])
                            rotate([0, 90, 0])
                                cylinder(d = 5.5, h = 4);
                // рёбра-косынки (жёсткость)
                for (s = [-1, 1])
                    translate([0, s*12, 0])
                        rotate([90, 0, 0])
                            linear_extrude(height = 2, center = true)
                                polygon(points = [[22, 8], [36, 8], [36, 22]]);
            }
            // окно под оправу объектива
            translate([cam_plate_dist - 3, 0, axis_z])
                rotate([0, 90, 0])
                    cylinder(d = cam_barrel_d, h = 10);
            // крепление основания: 3 винта M3 с зенковкой
            for (p = cam_base_holes) {
                translate([p[0], p[1], 5])
                    cylinder(d = m3_clear, h = 7);
                translate([p[0], p[1], 8.6])
                    cylinder(d1 = m3_clear, d2 = 6.5, h = 2.4);
            }
            // отверстия под термозайки M2 в бобышках
            for (dy = [-cam_hole_pitch/2, cam_hole_pitch/2])
                for (dz = [-cam_hole_pitch/2, cam_hole_pitch/2])
                    translate([cam_plate_dist + 2, dy, axis_z + dz])
                        rotate([0, 90, 0])
                            translate([0, 0, -0.1])
                                cylinder(d = m2_insert_d, h = m2_insert_h + 0.2);
        }
    }
}

// ============================================================================
//  СБОРКА / ВЫВОД
// ============================================================================
module assembly() {
    body();
    translate([0, 0, body_h]) lid();
    color([0.85, 0.75, 0.55]) slit();
    color([0.35, 0.45, 0.6]) grating();
    color([0.6, 0.8, 0.9, 0.8]) lens();
    color([0.25, 0.25, 0.28]) camera();
}

if (part == "body")         body();
else if (part == "lid")     lid();
else if (part == "slit")    slit();
else if (part == "grating") grating();
else if (part == "lens")    lens();
else if (part == "camera")  camera();
else                        assembly();
